<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="28dp">

            <!-- ===== HEADER ===== -->
            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:contentDescription="CareBuddy logo"
                android:src="@drawable/ic_carebuddy_mark" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="CareBuddy"
                android:textColor="@color/care_purple"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="IC Verification"
                android:textColor="@color/care_ink"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="24dp"
                android:gravity="center"
                android:text="Verify your identity to continue"
                android:textColor="@color/care_muted"
                android:textSize="15sp" />

            <!-- ===== SECTION 1: IC UPLOAD ===== -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="1. Upload your IC"
                android:textColor="@color/care_ink"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="10dp" />

            <ImageView
                android:id="@+id/ivIcImage"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:background="@drawable/bg_dashed_upload"
                android:scaleType="centerInside"
                android:contentDescription="IC preview"
                android:src="@android:drawable/ic_menu_gallery"
                app:tint="@color/care_muted" />

            <Button
                android:id="@+id/btnUploadIc"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card"
                android:text="Upload IC Photo"
                android:textAllCaps="false"
                android:textColor="@color/care_purple"
                android:textSize="15sp" />

            <!-- ===== SECTION 2: FACE SCAN ===== -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="2. Scan your face"
                android:textColor="@color/care_ink"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="10dp" />

            <ImageView
                android:id="@+id/ivFaceImage"
                android:layout_width="180dp"
                android:layout_height="180dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_dashed_upload"
                android:scaleType="centerCrop"
                android:contentDescription="Face preview"
                android:src="@android:drawable/ic_menu_camera"
                app:tint="@color/care_muted" />

            <TextView
                android:id="@+id/tvFaceStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="No face photo yet"
                android:textColor="@color/care_muted"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnScanFace"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card"
                android:text="Scan Face"
                android:textAllCaps="false"
                android:textColor="@color/care_purple"
                android:textSize="15sp" />

            <!-- ===== CONSENT CHECKBOX ===== -->
            <CheckBox
                android:id="@+id/cbVerificationConsent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="I agree to send my identity images for review"
                android:textColor="@color/care_ink"
                android:textSize="14sp" />

            <!-- ===== INFO TEXT ===== -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="Your information will be verified within 1–2 working days"
                android:textColor="@color/care_muted"
                android:textSize="13sp" />

            <!-- ===== VERIFY BUTTON ===== -->
            <Button
                android:id="@+id/btnVerifyIc"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_primary"
                android:text="Submit for Verification"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="17sp"
                android:textStyle="bold" />

            <!-- ===== FALLBACK BUTTON (hidden by default) ===== -->
            <Button
                android:id="@+id/btnContinueLocal"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card"
                android:text="Continue Without Uploading"
                android:textAllCaps="false"
                android:textColor="@color/care_muted"
                android:textSize="14sp"
                android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>