<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:padding="16dp"
    android:layout_marginBottom="12dp">

    <!-- ===== TOP ROW: Activity + Status badge ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvActivity"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            tools:text="Hospital Appointment"
            android:textColor="@color/care_ink"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_available"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            tools:text="New"
            android:textColor="#2E7D32"
            android:textSize="11sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- ===== Customer name ===== -->
    <TextView
        android:id="@+id/tvCustomer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        tools:text="👤  Aisyah Tan"
        android:textColor="@color/care_ink"
        android:textSize="14sp"
        android:textStyle="bold" />

    <!-- ===== Date + Time ===== -->
    <TextView
        android:id="@+id/tvDateTime"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        tools:text="📅  12 Oct 2025 • 10:00 AM – 12:00 PM"
        android:textColor="@color/care_muted"
        android:textSize="13sp" />

    <!-- ===== Location ===== -->
    <TextView
        android:id="@+id/tvLocation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        tools:text="📍  KPJ Seremban"
        android:textColor="@color/care_muted"
        android:textSize="13sp" />

    <!-- ===== Payment line ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_chip_small"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Estimated payment"
            android:textColor="@color/care_muted"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvPayment"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="RM 50.00"
            android:textColor="@color/care_purple"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- ===== ACTION BUTTONS ===== -->
    <LinearLayout
        android:id="@+id/actionRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnDecline"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_cancel_button"
            android:text="Decline"
            android:textAllCaps="false"
            android:textColor="#C62828"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnAccept"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_call_button"
            android:text="Accept"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- ===== View details link ===== -->
    <TextView
        android:id="@+id/tvViewDetails"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:padding="6dp"
        android:text="View full details"
        android:textColor="@color/care_purple"
        android:textSize="13sp"
        android:textStyle="bold" />

</LinearLayout>