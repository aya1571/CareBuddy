<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:padding="16dp"
    android:layout_marginBottom="12dp">

    <!-- ===== TOP ROW: Icon + Activity + Badge ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ivActivityIcon"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_chip_small"
            android:contentDescription="Activity icon"
            android:padding="8dp"
            android:src="@android:drawable/ic_menu_my_calendar"
            app:tint="@color/care_purple" />

        <TextView
            android:id="@+id/tvActivity"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            tools:text="Hospital Appointment"
            android:textColor="@color/care_ink"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_available"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            tools:text="Upcoming"
            android:textColor="#2E7D32"
            android:textSize="11sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- ===== DATE & TIME ===== -->
    <TextView
        android:id="@+id/tvDateTime"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        tools:text="📅 12 Oct 2025 • 10:00 AM – 12:00 PM"
        android:textColor="@color/care_muted"
        android:textSize="13sp" />

    <!-- ===== COMPANION ===== -->
    <TextView
        android:id="@+id/tvCompanion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        tools:text="🧑 Nur Aisyah"
        android:textColor="@color/care_muted"
        android:textSize="13sp" />

</LinearLayout>