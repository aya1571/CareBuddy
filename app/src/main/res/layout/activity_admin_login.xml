<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="28dp">

            <!-- ===== SHIELD ICON ===== -->
            <FrameLayout
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:background="@drawable/bg_icon_blue">

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="center"
                    android:contentDescription="Admin access"
                    android:src="@android:drawable/ic_lock_idle_lock"
                    app:tint="#1976D2" />

            </FrameLayout>

            <!-- ===== TITLE ===== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Admin Access"
                android:textColor="@color/care_ink"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="28dp"
                android:gravity="center"
                android:text="Restricted area. Authorised personnel only."
                android:textColor="@color/care_muted"
                android:textSize="14sp" />

            <!-- ===== EMAIL ===== -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Admin Email"
                android:textColor="@color/care_ink"
                android:textSize="14sp"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/etAdminEmail"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/bg_input_field"
                android:hint="admin@carebuddy.com"
                android:inputType="textEmailAddress"
                android:paddingHorizontal="16dp"
                android:textColor="@color/care_ink"
                android:textColorHint="@color/care_muted"
                android:textSize="15sp"
                android:layout_marginBottom="16dp" />

            <!-- ===== PASSWORD ===== -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Password"
                android:textColor="@color/care_ink"
                android:textSize="14sp"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/etAdminPassword"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/bg_input_field"
                android:hint="Enter password"
                android:inputType="textPassword"
                android:paddingHorizontal="16dp"
                android:textColor="@color/care_ink"
                android:textColorHint="@color/care_muted"
                android:textSize="15sp"
                android:layout_marginBottom="16dp" />

            <!-- ===== ADMIN CODE ===== -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Admin Code"
                android:textColor="@color/care_ink"
                android:textSize="14sp"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/etAdminCode"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/bg_input_field"
                android:hint="Enter 6-digit code"
                android:inputType="number"
                android:maxLength="6"
                android:paddingHorizontal="16dp"
                android:textColor="@color/care_ink"
                android:textColorHint="@color/care_muted"
                android:textSize="15sp"
                android:layout_marginBottom="24dp" />

            <!-- ===== SIGN IN BUTTON ===== -->
            <Button
                android:id="@+id/btnAdminSignIn"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/bg_primary"
                android:text="Sign In"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="17sp"
                android:textStyle="bold" />

            <!-- ===== BACK TO USER LOGIN ===== -->
            <TextView
                android:id="@+id/tvBackToUserLogin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:padding="8dp"
                android:text="Back to User Login"
                android:textColor="@color/care_purple"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>