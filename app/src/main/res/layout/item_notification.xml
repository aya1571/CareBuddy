<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card"
    android:clickable="true"
    android:focusable="true"
    android:orientation="horizontal"
    android:padding="14dp"
    android:layout_marginBottom="10dp">

    <!-- ===== ICON CIRCLE ===== -->
    <FrameLayout
        android:id="@+id/iconCircle"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_icon_blue">

        <ImageView
            android:id="@+id/ivIcon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:contentDescription="Notification icon"
            android:src="@android:drawable/ic_popup_reminder"
            app:tint="#1976D2" />

    </FrameLayout>

    <!-- ===== TEXT COLUMN ===== -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="14dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:text="Booking Accepted"
            android:textColor="@color/care_ink"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            tools:text="Your booking has been accepted by Nur Aisyah."
            android:textColor="@color/care_muted"
            android:textSize="13sp"
            android:lineSpacingExtra="2dp" />

        <TextView
            android:id="@+id/tvTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            tools:text="9 Oct 2025 • 08:03 AM"
            android:textColor="@color/care_muted"
            android:textSize="11sp" />

    </LinearLayout>

</LinearLayout>