<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:padding="16dp"
    android:layout_marginBottom="12dp">

    <!-- ===== TOP ROW: Name + Role badge ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            tools:text="Aisyah Tan"
            android:textColor="@color/care_ink"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvRole"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chip_small"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            tools:text="Elderly"
            android:textColor="@color/care_purple"
            android:textSize="11sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- ===== Email ===== -->
    <TextView
        android:id="@+id/tvEmail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        tools:text="aisyah@email.com"
        android:textColor="@color/care_muted"
        android:textSize="13sp" />

    <!-- ===== IMAGE PREVIEWS ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <!-- IC Image -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="IC Image"
                android:textColor="@color/care_muted"
                android:textSize="12sp"
                android:layout_marginBottom="4dp" />

            <ImageView
                android:id="@+id/ivIc"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:background="@drawable/bg_chip_small"
                android:contentDescription="IC preview"
                android:scaleType="centerCrop"
                android:src="@android:drawable/ic_menu_gallery"
                app:tint="@color/care_muted" />

        </LinearLayout>

        <!-- Face Image -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Face Photo"
                android:textColor="@color/care_muted"
                android:textSize="12sp"
                android:layout_marginBottom="4dp" />

            <ImageView
                android:id="@+id/ivFace"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:background="@drawable/bg_chip_small"
                android:contentDescription="Face preview"
                android:scaleType="centerCrop"
                android:src="@android:drawable/ic_menu_camera"
                app:tint="@color/care_muted" />

        </LinearLayout>

    </LinearLayout>

    <!-- ===== ACTIONS ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnReject"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_cancel_button"
            android:text="Reject"
            android:textAllCaps="false"
            android:textColor="#C62828"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnApprove"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_call_button"
            android:text="Approve"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>