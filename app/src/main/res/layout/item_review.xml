<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:padding="16dp"
    android:layout_marginBottom="10dp">

    <!-- ===== TOP ROW: Companion + Stars ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvCompanion"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            tools:text="Nur Aisyah"
            android:textColor="@color/care_ink"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvStars"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="★★★★★"
            android:textColor="#FFC107"
            android:textSize="16sp" />

    </LinearLayout>

    <!-- ===== REVIEWER ===== -->
    <TextView
        android:id="@+id/tvReviewer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        tools:text="By Aisyah Tan"
        android:textColor="@color/care_muted"
        android:textSize="12sp" />

    <!-- ===== COMMENT ===== -->
    <TextView
        android:id="@+id/tvComment"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        tools:text="Great companion! Very helpful."
        android:textColor="@color/care_ink"
        android:textSize="14sp"
        android:lineSpacingExtra="2dp" />

</LinearLayout>