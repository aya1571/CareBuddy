<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:padding="16dp"
    android:layout_marginBottom="12dp">

    <!-- ===== TOP ROW: Activity + Status ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvActivity"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            tools:text="Hospital Appointment"
            android:textColor="@color/care_ink"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_available"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            tools:text="Pending"
            android:textColor="#2E7D32"
            android:textSize="11sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- ===== DATE / TIME ===== -->
    <TextView
        android:id="@+id/tvDateTime"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        tools:text="📅 12 Oct 2025 • 10:00 AM – 12:00 PM"
        android:textColor="@color/care_muted"
        android:textSize="13sp" />

    <!-- ===== OWNER ===== -->
    <TextView
        android:id="@+id/tvOwner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        tools:text="👤 Customer: Aisyah Tan"
        android:textColor="@color/care_muted"
        android:textSize="13sp" />

    <!-- ===== COMPANION ===== -->
    <TextView
        android:id="@+id/tvCompanion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        tools:text="🧑 Companion: Nur Aisyah"
        android:textColor="@color/care_muted"
        android:textSize="13sp" />

    <!-- ===== LOCATION ===== -->
    <TextView
        android:id="@+id/tvLocation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        tools:text="📍 KPJ Seremban"
        android:textColor="@color/care_muted"
        android:textSize="13sp" />

    <!-- ===== PRICE ROW ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_chip_small"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Estimated total"
            android:textColor="@color/care_muted"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvTotal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="RM 50.00"
            android:textColor="@color/care_purple"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- ===== ACTIONS ===== -->
    <LinearLayout
        android:id="@+id/actionRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnViewDetails"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_card"
            android:text="View Details"
            android:textAllCaps="false"
            android:textColor="@color/care_purple"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnCancel"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_cancel_button"
            android:text="Cancel"
            android:textAllCaps="false"
            android:textColor="#C62828"
            android:textSize="13sp"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>